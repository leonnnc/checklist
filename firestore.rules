rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // ── Usuarios ─────────────────────────────────────────────────────────
    match /usuarios/{uid} {
      // Cualquier autenticado puede leer su propio perfil
      allow read: if isAuth() && (isOwner(uid) || isAdmin());
      // Solo admin puede crear/actualizar/eliminar
      allow write: if isAdmin();
      // Permitir al propio usuario crear su documento (al registrarse)
      allow create: if isOwner(uid);
    }

    // ── Grupos ───────────────────────────────────────────────────────────
    match /grupos/{grupoId} {
      // Usuarios autenticados pueden leer su grupo asignado
      allow read: if isAuth();
      // Solo admin puede escribir
      allow write: if isAdmin();
    }

    // ── Progreso ─────────────────────────────────────────────────────────
    match /progreso/{progresoId} {
      // Lectura: el propio usuario o admin
      allow read: if isAuth() &&
        (resource.data.usuarioId == request.auth.uid || isAdmin());
      // Escritura: solo el propio usuario puede marcar sus tareas
      // y solo puede escribir su propio uid
      allow create, update: if isAuth() &&
        request.resource.data.usuarioId == request.auth.uid;
      // Solo admin puede eliminar
      allow delete: if isAdmin();
    }
  }
}
